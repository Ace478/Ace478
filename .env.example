# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# Optionnel : ID de ton serveur. Si renseigné, les commandes sont installées
# instantanément sur ce serveur (sinon globalement, ce qui peut prendre ~1h).
GUILD_ID=

# Optionnel : ID(s) des propriétaires du bot (séparés par des virgules).
# Ils ont tous les droits sur tous les serveurs, comme le propriétaire du serveur.
BOT_OWNERS=
